# Azure VM Deployment Environment Template
# Copy to /opt/bts/.env on the Azure VM (chmod 600 /opt/bts/.env).
# Never commit real .env files or credentials to Git.

# Container images in GHCR (updated automatically by deploy.sh upon successful rollout)
API_IMAGE=ghcr.io/hwolp/brain-tumor-segmentation-api
WEB_IMAGE=ghcr.io/hwolp/brain-tumor-segmentation-web
IMAGE_TAG=latest

# Public ports on Azure VM
HTTP_PORT=80
# HTTPS_PORT=443

# PostgreSQL (use URL-safe password characters, e.g. `openssl rand -hex 24`)
POSTGRES_DB=bts_prod
POSTGRES_USER=bts_user
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_STRONG_DB_PASSWORD
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Phase 1: Public IP over HTTP (no domain/TLS yet).
# BE enforces COOKIE_SECURE=true and https:// PUBLIC_ORIGIN whenever APP_ENV=production.
APP_ENV=local
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://REPLACE_WITH_AZURE_PUBLIC_IP
# ALLOWED_ORIGINS must be a JSON array (e.g. ["http://127.0.0.1:80"]) or []
ALLOWED_ORIGINS=[]

# Phase 2: Once domain + HTTPS are enabled (see deploy/azure/README.md), switch to:
# APP_ENV=production
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://your-domain.example.com
# ALLOWED_ORIGINS=[]

# Application & logging
SERVICE_NAME=brain-tumor-api
LOG_LEVEL=INFO

# JWT RS256 metadata (keys are auto-generated once in bts_secrets volume if absent)
JWT_KEY_ID=azure-rs256-v1
JWT_ISSUER=brain-tumor-api
JWT_AUDIENCE=brain-tumor-web
AUTO_INIT_JWT_KEYS=true

# AI Worker authentication (generate >= 32 chars, e.g. `openssl rand -urlsafe 32` or `openssl rand -hex 32`)
WORKER_TOKEN=REPLACE_WITH_STRONG_32_CHAR_WORKER_TOKEN
WORKER_API_BASE_URL=http://api:8000
MODEL_CHECKPOINT_PATH=/models/best.pt
WORKER_DEVICE=cpu
