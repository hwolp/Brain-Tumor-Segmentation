# Brain Tumor Segmentation Backend Environment Template
# Copy to BE/.env for local development. Never commit real secrets or private keys.

APP_ENV=local
SERVICE_NAME=brain-tumor-api
LOG_LEVEL=INFO

# PostgreSQL (matches docker-compose.yml defaults when using local dev DB)
DATABASE_URL=postgresql+psycopg://bts_user:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/bts_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Private local file storage root (outside web root)
STORAGE_ROOT=./storage

# Origin & cookie security
PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false

# JWT RS256 signing / verification (placeholder paths outside repository)
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_KEY_ID=local-rs256-v1
JWT_ISSUER=brain-tumor-api
JWT_AUDIENCE=brain-tumor-web

# AI model artifact & worker configuration (outside repository)
MODEL_MANIFEST_PATH=./models/model_manifest.json
MODEL_CHECKPOINT_PATH=./models/checkpoint.pt
WORKER_API_BASE_URL=http://127.0.0.1:8000
WORKER_TOKEN=REPLACE_WITH_WORKER_SERVICE_TOKEN
WORKER_DEVICE=cpu
